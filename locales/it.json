    },
    "apps.index.text.0048": {
      "value": "Alcune app avranno anche una versione nativa per Android con gli stessi impegni umani, etici, linguistici, di privacy e accessibilità. Sarà progettata con sincerità per Android, non presentata come copia visiva identica: parte della profondità, dei materiali, del movimento e dell’integrazione di sistema possibili sulle piattaforme Apple non può essere riprodotta esattamente allo stesso modo.",
      "sourceSha256": "9dab1ad64c7c4c91b436e729cd7cff6b7aad3794dbdfe82f932f9aaff868f698"
    },
