    "apps.index.text.0042": {
      "value": "Ogni app per piattaforme Apple viene progettata e verificata secondo le linee guida Apple applicabili sull’accessibilità per tutto il suo ciclo di vita, mai come edizione separata o rifinitura finale.",
      "sourceSha256": "f92b94c5486c7f7dea125e542f287cd683bd528cc951db256deb4b3fcecc7489"
    },
    "apps.index.text.0043": {
      "value": "Quattordici lingue, ovunque.",
