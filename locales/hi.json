      "sourceSha256": "22fd7b42a3583a9e98aba945ffe50311b21ce5c603743236e0bbb725db5aebd9"
    },
    "apps.index.text.0071": {
      "value": "हम यथासंभव कम डेटा एकत्र करते हैं, जहाँ उत्पाद अनुमति देता है वहाँ डेटा डिवाइस पर रखते हैं, और अनुमतियों, संग्रहण, एन्क्रिप्शन तथा हटाने को डिज़ाइन के निर्णय मानते हैं।",
      "sourceSha256": "2bdcab9bb048d1d9d443c9e1ac01a6cf1b9cbc9ec8f83664d8baf1811e337495"
    },
    "apps.index.text.0072": {
      "value": "व्यक्ति पहले",
      "sourceSha256": "5b4f83fad5351a96eec969e4432b2a69d920d2e0d5742025d353b8f763e3934e"
    },
    "apps.index.text.0073": {
      "value": "सुलभता को पूरे कार्य के संदर्भ में देखा जाता है—बड़े टेक्स्ट, सहायक तकनीकों, कम गति, स्पष्ट कंट्रास्ट और समझने या कार्रवाई करने के एक से अधिक तरीकों के समर्थन के साथ।",
      "sourceSha256": "45d48664447a3742bd2b2f263f069b3dfc47af669bb92dccf6163d5337941644"
    },
    "apps.index.text.0074": {
      "value": "सबूत, भरोसा नहीं",
      "sourceSha256": "1fab7bb5cb4d67127ed654d8c6afdbd8079748238acdaf8ff369d92e1931facd"
    },
    "apps.index.text.0075": {
      "value": "परीक्षण, डिवाइस जाँच और रिलीज़ मानदंड हमारे दावों का आधार हैं। हम जो योजनाबद्ध है, जो बनाया गया है और जो सत्यापित किया गया है, उनमें स्पष्ट अंतर रखते हैं।",
      "sourceSha256": "fe28db52503e80e6f9112d44f4e2584c2d2f13b92e1bb739bea02372fc432359"
    },
    "apps.index.text.0076": {
