    "apps.index.text.0039": {
      "value": "इंसान पहले। डिज़ाइन से ही निजी। शुरुआत से ही सुगम।",
      "sourceSha256": "83c81cf63bbcb9e0ad34e090652402551b0a432804abce72341a3896cba710f3"
    },
    "apps.index.text.0040": {
      "value": "हर Moving Truth ऐप एक ही स्थायी बुनियाद से शुरू होता है: मानवीय गरिमा, नैतिक संयम, समझने योग्य गोपनीयता और उपयोगकर्ता की सेवा करने वाली तकनीक। सुंदरता को कार्य को सहज बनाना चाहिए, छिपाना नहीं।",
      "sourceSha256": "72766be6dd3bdecc6f5f4a20cf3d02aa03d885beeab9166ec3958e6bdbcb006f"
    },
    "apps.index.text.0041": {
      "value": "सुगम्यता हर रिलीज़ की अनिवार्य शर्त है।",
      "sourceSha256": "6c4c855a8a0b00f2ecf5a6544126481d4d141c3d116cd578fdc121be7ea4db9a"
    },
    "apps.index.text.0042": {
      "value": "Apple प्लेटफ़ॉर्म का हर ऐप अपने पूरे जीवनकाल में Apple के लागू सुगम्यता दिशानिर्देशों के अनुसार डिज़ाइन और जाँचा जाता है — अलग संस्करण या आख़िरी सजावट की तरह नहीं।",
      "sourceSha256": "f92b94c5486c7f7dea125e542f287cd683bd528cc951db256deb4b3fcecc7489"
    },
    "apps.index.text.0043": {
      "value": "चौदह भाषाएँ, हर जगह।",
      "sourceSha256": "552bc02c76d02d728c59ab5f137ad24211337e3230d0f0cb6e0d4f16af2f08fb"
    },
    "apps.index.text.0044": {
      "value": "हर मौजूदा और भविष्य का Moving Truth ऐप एक ही चौदह-भाषा संरचना से शुरू होता है, ताकि दुनिया भर के लोगों को पूरा अनुभव मिले, केवल अनूदित टुकड़ा नहीं।",
      "sourceSha256": "a3e3a1fa80a3962f52862d1c8b6a2df75f5851754066c2156b44aecf1c05d915"
    },
    "apps.index.text.0045": {
      "value": "गोपनीयता और नैतिकता संरचना का हिस्सा हैं।",
      "sourceSha256": "40996c473f1200fa35b1236fd4cfe69f0d5e62dd5439cdce14efd994db7eeb36"
    },
    "apps.index.text.0046": {
      "value": "किसी का आंतरिक जीवन उत्पाद नहीं बनना चाहिए। डेटा संग्रह, अनुमतियाँ, व्यवसाय मॉडल, सूचनाएँ और नई तकनीक ईमानदार, उचित और मानवीय नियंत्रण में रहनी चाहिए।",
      "sourceSha256": "8f5cd33b9cdea13d227d002d6beb60b72ba4a975b2536772c35e77de63a85ab4"
    },
    "apps.index.text.0047": {
      "value": "iOS हमारा संदर्भ रूप है।",
      "sourceSha256": "6c0ef59b9e77bd4770daa48a03774d0b5d30067528f4e0cbb67a3d9a499b738b"
    },
    "apps.index.text.0048": {
      "value": "कुछ ऐप्स का अपना Android संस्करण भी होगा, जिसमें वही मानवीय, गोपनीयता, सुगम्यता, नैतिक और भाषाई प्रतिबद्धताएँ होंगी। उसे Android के लिए ईमानदारी से बनाया जाएगा, एक जैसी दिखने वाली नकल की तरह पेश नहीं किया जाएगा: Apple प्लेटफ़ॉर्म पर संभव कुछ गहराई, सामग्री, गति और सिस्टम एकीकरण को वहाँ बिल्कुल उसी तरह दोहराया नहीं जा सकता।",
      "sourceSha256": "9dab1ad64c7c4c91b436e729cd7cff6b7aad3794dbdfe82f932f9aaff868f698"
    },
