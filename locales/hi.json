    "apps.index.text.0067": {
      "value": "पूरे ऐप परिवार में तकनीकी निर्णय उपयोग करने वाले व्यक्ति की सेवा में लिए जाते हैं। हर ऐप की अपनी संरचना है, लेकिन सभी को वही मानक दिशा देते हैं।",
      "sourceSha256": "5498563802532dd598635f1688d679e0f3c0e50b77bab7b4d815804ff6897908"
    },
    "apps.index.text.0068": {
      "value": "डिज़ाइन द्वारा मूल निवासी",
      "sourceSha256": "025f6a9359f5cf5490690f057d9dc62fbcf59ebb98970452e8f272348a43c1d4"
    },
    "apps.index.text.0069": {
      "value": "जहाँ प्लेटफ़ॉर्म के मूल उपकरण सबसे स्पष्ट और भरोसेमंद अनुभव देते हैं, हम उन्हें चुनते हैं। उत्पाद दिशा तय करता है; तकनीक उसका अनुसरण करती है।",
      "sourceSha256": "dd504d10aacdca60ddb8340919daaccb79fa303a2dca26550a0d4bfe38bdb0e6"
    },
    "apps.index.text.0070": {
