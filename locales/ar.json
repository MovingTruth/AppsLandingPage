    },
    "apps.index.text.0044": {
      "value": "يبدأ كل تطبيق حالي أو مستقبلي من Moving Truth بالبنية نفسها المؤلفة من أربع عشرة لغة، كي يحصل الناس حول العالم على التجربة كاملة، لا على جزء مترجم منها.",
      "sourceSha256": "a3e3a1fa80a3962f52862d1c8b6a2df75f5851754066c2156b44aecf1c05d915"
    },
    "apps.index.text.0045": {
