    },
    "apps.index.text.0067": {
      "value": "앱 제품군 전반에서 기술적 결정은 사용하는 사람을 위해 내려집니다. 각 앱은 고유한 아키텍처를 가지며 같은 기준의 안내를 받습니다.",
      "sourceSha256": "5498563802532dd598635f1688d679e0f3c0e50b77bab7b4d815804ff6897908"
    },
    "apps.index.text.0068": {
      "value": "기본 설계",
      "sourceSha256": "025f6a9359f5cf5490690f057d9dc62fbcf59ebb98970452e8f272348a43c1d4"
    },
    "apps.index.text.0069": {
      "value": "가장 명확하고 신뢰할 수 있는 경험을 제공할 때 플랫폼 네이티브 도구를 선택합니다. 제품이 방향을 이끌고 기술은 그 뒤를 따릅니다.",
      "sourceSha256": "dd504d10aacdca60ddb8340919daaccb79fa303a2dca26550a0d4bfe38bdb0e6"
    },
    "apps.index.text.0070": {
